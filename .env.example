# ============================================================
# NexusOps AI — Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
APP_NAME=NexusOps AI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
SECRET_KEY=change-me-to-a-secure-random-string-32chars-min
API_PREFIX=/api/v1

# ----------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://nexusops:nexusops_secret@localhost:5432/nexusops
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ----------------------------------------------------------
# Redis
# ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ----------------------------------------------------------
# Qdrant (Vector DB)
# ----------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_INFRA=infrastructure_vectors
QDRANT_COLLECTION_INCIDENTS=incident_vectors

# ----------------------------------------------------------
# AI / LLM
# ----------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_MAX_TOKENS=4096

# Ollama (local LLM fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# LLM Provider: openai | ollama
LLM_PROVIDER=openai

# ----------------------------------------------------------
# Kafka / Redpanda
# ----------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=nexusops.events
KAFKA_TOPIC_INCIDENTS=nexusops.incidents
KAFKA_TOPIC_METRICS=nexusops.metrics
KAFKA_CONSUMER_GROUP=nexusops-consumer

# ----------------------------------------------------------
# Kubernetes
# ----------------------------------------------------------
KUBECONFIG_PATH=/root/.kube/config
K8S_IN_CLUSTER=false
K8S_API_TIMEOUT=30

# ----------------------------------------------------------
# Security
# ----------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-different-secure-key
JWT_ALGORITHM=HS256
JWT_ISSUER=nexusops-ai
JWT_AUDIENCE=nexusops-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS configuration (comma-separated or JSON arrays)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_HEADERS=Authorization,Content-Type,X-Request-ID

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
SECURITY_HEADERS_ENABLED=true

# ----------------------------------------------------------
# Observability / OpenTelemetry
# ----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=nexusops-backend
PROMETHEUS_METRICS_PORT=9090

# ----------------------------------------------------------
# Trivy (Security Scanner)
# ----------------------------------------------------------
TRIVY_SERVER_URL=http://localhost:4954

# ----------------------------------------------------------
# OPA (Open Policy Agent)
# ----------------------------------------------------------
OPA_SERVER_URL=http://localhost:8181

# ----------------------------------------------------------
# Google Stitch Design Integration
# ----------------------------------------------------------
STITCH_PROJECT_ID=17469866534806598593
STITCH_API_KEY=
GOOGLE_CLOUD_PROJECT=17469866534806598593

# ----------------------------------------------------------
# Logging
# ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
